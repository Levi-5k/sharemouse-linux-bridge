#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -Eeuo pipefail

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
DATA_DIR="${SHAREMOUSE_DATA_DIR:-$DATA_HOME/sharemouse-linux}"
STATIC_ARCHIVE="$DATA_DIR/sharemouse-static.tar.zst"
PREFIX_ARCHIVE="$DATA_DIR/sharemouse-prefix.tar.zst"
STATE_DIR="$DATA_DIR/state"

for path in /tmp/box64-root /tmp/sharemouse-wine /tmp/sharemouse-portable /tmp/orangepi-sharemouse/prefix; do
    if [[ ! -e "$path" ]]; then
        echo "Required runtime path is missing: $path" >&2
        echo "Start and validate the local Box64/Wine/ShareMouse setup first." >&2
        exit 1
    fi
done

mkdir -p "$DATA_DIR" "$STATE_DIR"
umask 077

static_new="$STATIC_ARCHIVE.new"
prefix_new="$PREFIX_ARCHIVE.new"
rm -f "$static_new" "$prefix_new"

echo "Capturing Box64, Wine, and user-supplied ShareMouse runtime..."
tar -C /tmp -cf - box64-root sharemouse-wine sharemouse-portable |
    zstd -8 -T2 -q -o "$static_new"
zstd -tq "$static_new"

echo "Capturing the Wine prefix..."
tar -C /tmp -cf - orangepi-sharemouse/prefix |
    zstd -8 -T2 -q -o "$prefix_new"
zstd -tq "$prefix_new"

config_dir=/tmp/orangepi-sharemouse/prefix/drive_c/ProgramData/ShareMouse
[[ -r "$config_dir/config.ini" ]] && install -m 600 "$config_dir/config.ini" "$STATE_DIR/config.ini"
[[ -r "$config_dir/layouts.xml" ]] && install -m 600 "$config_dir/layouts.xml" "$STATE_DIR/layouts.xml"

mv -f "$static_new" "$STATIC_ARCHIVE"
mv -f "$prefix_new" "$PREFIX_ARCHIVE"
chmod 600 "$STATIC_ARCHIVE" "$PREFIX_ARCHIVE"

echo "Runtime archives created in $DATA_DIR."
echo "They contain proprietary and machine-specific files; do not commit or redistribute them."
